{
  "name": "repairloop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build && vite build --ssr client/entry-server.jsx --outDir dist/server",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "INTEGRATION=true node --env-file-if-exists=.env --test tests/integration.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "ai:index": "node --env-file-if-exists=.env scripts/index-knowledge.js",
    "ai:eval": "node --env-file-if-exists=.env scripts/eval.js",
    "check:coverage": "node scripts/check-coverage.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.20.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "openai": "^6.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.18.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.10.1",
    "prisma": "^6.19.0",
    "supertest": "^7.1.4",
    "vite": "^6.4.1"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
