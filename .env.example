# Copy to .env. Demo mode stores data in memory and makes NO external payments.
APP_MODE=demo
PORT=3000
APP_URL=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://repairloop:local_dev_only@localhost:5432/repairloop?schema=public
MONGODB_URI=mongodb://localhost:27017/repairloop
REDIS_URL=redis://localhost:6379
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
# Set current provider prices (USD per million tokens); blank means unknown cost.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
AI_EMBEDDING_USD_PER_MILLION=
SEED_ADMIN_EMAIL=admin@repairloop.local
SEED_ADMIN_PASSWORD=
